{
  "name": "kanji-clustering-analysis",
  "description": "Detect similar kanji characters with k-means method.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt preview",
    "generate": "nuxt generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "percy": "mkdir -p .output/public/__percy__ && cp percy/affinities.json .output/public/__percy__/ && percy snapshot .output/public",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt prepare && nuxi typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "4.6.1",
    "nuxt-gtag": "5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@percy/cli": "^1.32.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  }
}
